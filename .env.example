# --- Shared ---
NODE_ENV=production

# --- Database ---
POSTGRES_USER=dsbot
# Придумай пароль из латинских букв и цифр; тот же пароль вставь в DATABASE_URL.
POSTGRES_PASSWORD=dsbot_password
POSTGRES_DB=dsbot
DATABASE_URL=postgresql://dsbot:dsbot_password@postgres:5432/dsbot?schema=public

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Необязательно: прежний способ настройки. Новые настройки ролей вводятся в панели.
VALORANT_ROLE_IDS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Пароль, который нужно написать в группе после добавления бота, чтобы активировать мост
TELEGRAM_JOIN_PASSWORD=community
# Опционально: фиксированный chat id (если не используешь активацию паролем)
TELEGRAM_CHAT_ID=

# --- Web panel ---
WEB_PORT=3000
# Password for the panel login page
PANEL_PASSWORD=admin
# Shared secret used by the bots to authenticate against the web panel API
PANEL_API_SECRET=change-me

# --- Rules engine ---
# How often (ms) the voice-state aggregator re-evaluates rules
RULES_EVAL_INTERVAL_MS=30000
